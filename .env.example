# Explicit local development. For production use DEBUG=False and a random secret.
DEBUG=True
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Docker uses a persistent /data volume; bare Python defaults to checkout-local paths.
# MEDIA_ROOT=/data/media
# SQLITE_PATH=/data/db.sqlite3
# DATABASE_URL=postgresql://user:password@database:5432/homeinventory
# Production external PostgreSQL defaults to certificate and hostname verification.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# Enable only behind an exclusive, trusted TLS reverse proxy.
TRUST_PROXY_HTTPS=False
WEB_CONCURRENCY=2
